    def _render_insights(self, daily):
        for w in self.ins_frame.winfo_children():
            w.destroy()

        try:
            codes    = [c for c in (daily.get('weather_code') or [])[:30] if c is not None]
            t_max    = [float(x) for x in (daily.get('temperature_2m_max')  or [])[:30] if x is not None]
            t_min    = [float(x) for x in (daily.get('temperature_2m_min')  or [])[:30] if x is not None]
            precip   = [float(x) for x in (daily.get('precipitation_probability_max') or [])[:30] if x is not None]
            times    = (daily.get('time') or [])[:30]
            uv_arr   = [float(x) for x in (daily.get('uv_index_max')       or [])[:30] if x is not None]
            wind_max = [float(x) for x in (daily.get('wind_speed_10m_max') or [])[:30] if x is not None]

            if not t_max:
                return

            n = min(len(t_max), len(precip), len(times))

            def tfmt(i):
                try:
                    dt = datetime.fromisoformat(times[i])
                    return f"{self.MONTHS[dt.month-1]} {dt.day}"
                except Exception:
                    return f"Day {i+1}"

            # 2x3 grid
            for col in range(3):
                self.ins_frame.columnconfigure(col, weight=1)

            def make_card(row, col, title):
                f = tk.Frame(self.ins_frame, bg=self.CARD,
                             highlightbackground=self.BORDER, highlightthickness=1)
                f.grid(row=row, column=col, sticky='nsew', padx=4, pady=4)
                tk.Label(f, text=title, font=("Segoe UI", 9, "bold"),
                         bg=self.CARD, fg=self.MUTED).pack(anchor='w', padx=10, pady=(9,5))
                tk.Frame(f, bg=self.BORDER, height=1).pack(fill='x', padx=8)
                return f

            def irow(f, key, val, color=None, bar_pct=None):
                r = tk.Frame(f, bg=self.CARD)
                r.pack(fill='x', padx=10, pady=(4,0))
                tk.Label(r, text=key, font=("Segoe UI", 8),
                         bg=self.CARD, fg=self.MUTED2).pack(side='left')
                tk.Label(r, text=val, font=("Segoe UI", 9, "bold"),
                         bg=self.CARD, fg=color or self.TEXT2).pack(side='right')
                if bar_pct is not None:
                    bv = tk.Canvas(f, height=4, bg=self.CARD, highlightthickness=0)
                    bv.pack(fill='x', padx=10, pady=(2,0))
                    fc = color or self.ACCENT
                    def _draw(cv=bv, pct=bar_pct, fc=fc):
                        W = cv.winfo_width() or 160
                        cv.delete('all')
                        cv.create_rectangle(0, 0, W, 4, fill=self.BORDER, outline='')
                        cv.create_rectangle(0, 0, max(2, int(W * min(pct,100)/100)), 4, fill=fc, outline='')
                    bv.bind('<Configure>', lambda e, fn=_draw: fn())
                    bv.after(60, _draw)

            # Card 1: Temperature
            c1 = make_card(0, 0, "🌡️  Temperature")
            avg_hi = sum(t_max)/len(t_max)
            avg_lo = sum(t_min)/len(t_min)
            max_i  = t_max.index(max(t_max))
            min_i  = t_min.index(min(t_min))
            mid    = max(len(t_max)//2, 1)
            diff   = (sum(t_max[mid:])/max(len(t_max)-mid,1)) - (sum(t_max[:mid])/mid)
            if   diff >  1.5: trend, tc = f"▲ Warming +{round(diff,1)}°", self.DANGER
            elif diff < -1.5: trend, tc = f"▼ Cooling {round(diff,1)}°",  self.GOOD
            else:              trend, tc = "→ Stable",                      self.TEXT3
            heat_days = sum(1 for t in t_max if t >= 35)
            comf_days = sum(1 for hi, lo in zip(t_max, t_min) if 20 <= hi <= 30 and lo >= 18)
            irow(c1, "Avg High / Low",       f"{self._c(round(avg_hi))}° / {self._c(round(avg_lo))}°", self.WARN)
            irow(c1, "Hottest Day",          f"{tfmt(max_i)}  {self._c(t_max[max_i])}°",  self.DANGER)
            irow(c1, "Coolest Day",          f"{tfmt(min_i)}  {self._c(t_min[min_i])}°",  self.GOOD)
            irow(c1, "Heat Stress Days ≥35°", str(heat_days), self.DANGER if heat_days>3 else self.TEXT2)
            irow(c1, "Comfortable Days",     str(comf_days),  self.GOOD)
            irow(c1, "Trend",                trend,           tc)
            tk.Label(c1, bg=self.CARD).pack(pady=4)

            # Card 2: Precipitation
            c2 = make_card(0, 1, "🌧️  Precipitation")
            rainy   = sum(1 for r in precip if r > 40)
            dry     = len(precip) - rainy
            max_r_i = precip.index(max(precip))
            avg_r   = sum(precip)/len(precip)
            max_dry = max_wet = cur_dry = cur_wet = 0
            for r in precip:
                if r <= 30: cur_dry += 1; cur_wet = 0
                else:       cur_wet += 1; cur_dry = 0
                max_dry = max(max_dry, cur_dry)
                max_wet = max(max_wet, cur_wet)
            irow(c2, "Rainy / Dry Days",   f"{rainy} / {dry}", self.TEXT2)
            irow(c2, "Heaviest Rain Day",  f"{tfmt(max_r_i)}  {int(precip[max_r_i])}%", self.DANGER, bar_pct=precip[max_r_i])
            irow(c2, "Avg Rain Chance",    f"{round(avg_r)}%", self.TEXT2, bar_pct=avg_r)
            irow(c2, "Longest Dry Streak", f"{max_dry} days",  self.GOOD)
            irow(c2, "Longest Wet Streak", f"{max_wet} days",  self.WARN if max_wet>4 else self.TEXT2)
            tk.Label(c2, bg=self.CARD).pack(pady=4)

            # Card 3: UV & Sunshine
            c3 = make_card(0, 2, "☀️  UV & Sunshine")
            if uv_arr:
                uv_pk_i = uv_arr.index(max(uv_arr))
                avg_uv  = sum(uv_arr)/len(uv_arr)
                ext_uv  = sum(1 for u in uv_arr if u >= 8)
                high_uv = sum(1 for u in uv_arr if 6 <= u < 8)
                mod_uv  = sum(1 for u in uv_arr if 3 <= u < 6)
                irow(c3, "Peak UV Day",          f"{tfmt(uv_pk_i)}  UV {round(uv_arr[uv_pk_i],1)}", self.DANGER)
                irow(c3, "Avg UV Index",         str(round(avg_uv,1)), self.WARN if avg_uv>=6 else self.TEXT2, bar_pct=min(avg_uv*8,100))
                irow(c3, "Extreme UV Days (≥8)", str(ext_uv),  self.DANGER if ext_uv>0  else self.GOOD)
                irow(c3, "High UV Days (6–8)",   str(high_uv), self.WARN)
                irow(c3, "Moderate UV (3–6)",    str(mod_uv),  self.TEXT2)
            clear_d = sum(1 for cd in codes if cd <= 1)
            storm_d = sum(1 for cd in codes if cd >= 95)
            irow(c3, "Clear / Sunny Days",  str(clear_d), self.GOOD)
            irow(c3, "Thunderstorm Days",   str(storm_d), self.DANGER if storm_d>2 else self.TEXT2)
            tk.Label(c3, bg=self.CARD).pack(pady=4)

            # Card 4: Wind
            c4 = make_card(1, 0, "💨  Wind Summary")
            if wind_max:
                avg_w   = sum(wind_max)/len(wind_max)
                max_w_i = wind_max.index(max(wind_max))
                calm    = sum(1 for w in wind_max if w < 15)
                breezy  = sum(1 for w in wind_max if 15 <= w < 30)
                windy   = sum(1 for w in wind_max if w >= 30)
                irow(c4, "Avg Max Wind",         f"{round(avg_w)} km/h", self.TEXT2, bar_pct=min(avg_w*2,100))
                irow(c4, "Windiest Day",         f"{tfmt(max_w_i)}  {round(wind_max[max_w_i])} km/h", self.WARN)
                irow(c4, "Calm Days (<15 km/h)", str(calm),   self.GOOD)
                irow(c4, "Breezy Days (15–30)",  str(breezy), self.TEXT2)
                irow(c4, "Windy Days (>30 km/h)",str(windy),  self.WARN if windy>2 else self.TEXT2)
            tk.Label(c4, bg=self.CARD).pack(pady=4)

            # Card 5: Health & Comfort
            c5 = make_card(1, 1, "🏥  Health & Comfort")
            if t_max and precip:
                ideal    = sum(1 for hi, r in zip(t_max, precip) if 20<=hi<=30 and r<40)
                exercise = sum(1 for hi, r in zip(t_max, precip) if 18<=hi<=32 and r<30)
                heat_al  = sum(1 for t in t_max if t >= 36)
                avoid    = sum(1 for hi, r in zip(t_max, precip) if r>=75 or hi>=38)
                score    = round((ideal/len(t_max))*100)
                sc_col   = self.GOOD if score>=50 else (self.WARN if score>=25 else self.DANGER)
                irow(c5, "Comfort Score",          f"{score} / 100",  sc_col, bar_pct=score)
                irow(c5, "Ideal Outdoor Days",     str(ideal),        self.GOOD)
                irow(c5, "Good Exercise Days",     str(exercise),     self.ACCENT2)
                irow(c5, "Heat Alert Days (≥36°)", str(heat_al),      self.DANGER if heat_al>0 else self.GOOD)
                irow(c5, "Stay-Indoors Days",      str(avoid),        self.DANGER if avoid>3  else self.TEXT2)
            tk.Label(c5, bg=self.CARD).pack(pady=4)

            # Card 6: Best Periods
            c6 = make_card(1, 2, "⭐  Best Periods")
            if n >= 3:
                def day_score(i):
                    r = precip[i] if i < len(precip) else 50
                    t = t_max[i]  if i < len(t_max)  else 30
                    return (max(0, 100 - abs(t-25)*5) + max(0, 100-r)) / 2
                scores  = [day_score(i) for i in range(n)]
                best_i  = scores.index(max(scores))
                worst_i = scores.index(min(scores))
                best3s, best3st = 0, 0
                for i in range(n-2):
                    s = sum(scores[i:i+3])/3
                    if s > best3s: best3s, best3st = s, i
                best3e  = min(best3st+2, n-1)
                avg_sc  = sum(scores)/len(scores)
                if   avg_sc >= 70: outlook, oc = "Excellent — mostly fine weather",  self.GOOD
                elif avg_sc >= 55: outlook, oc = "Good — occasional disruptions",    self.GOOD
                elif avg_sc >= 40: outlook, oc = "Mixed — plan around the rain",     self.WARN
                elif avg_sc >= 25: outlook, oc = "Poor — mostly unsettled",          self.DANGER
                else:              outlook, oc = "Severe — expect storms",           self.DANGER
                irow(c6, "Best Single Day",   f"{tfmt(best_i)}  ★ {round(scores[best_i])}%",  self.GOOD)
                irow(c6, "Best 3-Day Window", f"{tfmt(best3st)} – {tfmt(best3e)}",             self.ACCENT2)
                irow(c6, "Worst Day",         f"{tfmt(worst_i)}  ⚠ {round(scores[worst_i])}%", self.DANGER)
                ok = tk.Frame(c6, bg=self.CARD)
                ok.pack(fill='x', padx=10, pady=(6,0))
                tk.Label(ok, text="Overall Outlook", font=("Segoe UI", 8),
                         bg=self.CARD, fg=self.MUTED2).pack(anchor='w')
                tk.Label(ok, text=outlook, font=("Segoe UI", 9, "bold"),
                         bg=self.CARD, fg=oc, wraplength=165, justify='left').pack(anchor='w')
            tk.Label(c6, bg=self.CARD).pack(pady=4)

            self.ins_frame.update_idletasks()

        except Exception as e:
            err = tk.Frame(self.ins_frame, bg=self.CARD,
                           highlightbackground=self.BORDER, highlightthickness=1)
            err.pack(fill='x', padx=4, pady=4)
            tk.Label(err, text=f"Insights error: {e}",
                     font=("Segoe UI", 9), bg=self.CARD, fg=self.WARN,
                     padx=10, pady=8).pack(anchor='w')

    # ─────────────────────────────────────────────────────────────
    def _render_sidebar_extra(self, cur, daily):
        # Resolve dew_point and cloud_cover from current hour in hourly data
        hourly = self.weather_data.get('hourly', {}) if self.weather_data else {}
        now    = datetime.now()
        h_times = hourly.get('time', [])
        h_dew   = hourly.get('dew_point_2m', [])
        h_cloud = hourly.get('cloud_cover', [])
        h_vis   = hourly.get('visibility', [])
        cur_h_idx = 0
        for i, t_str in enumerate(h_times):
            try:
                dt = datetime.fromisoformat(t_str.replace('Z',''))
                if dt >= now.replace(minute=0, second=0, microsecond=0):
                    cur_h_idx = i; break
            except Exception:
                pass
        dew   = h_dew[cur_h_idx]   if cur_h_idx < len(h_dew)   else None
        cloud = h_cloud[cur_h_idx] if cur_h_idx < len(h_cloud) else 0
        vis   = h_vis[cur_h_idx]   if cur_h_idx < len(h_vis)   else None

        # ── Wind compass ─────────────────────────────────────────
        wind_spd  = round(cur.get('wind_speed_10m', 0))
        wind_deg  = cur.get('wind_direction_10m', 0) or 0
        gust_list = daily.get('wind_gusts_10m_max') or []
        max_list  = daily.get('wind_speed_10m_max') or []
        gust  = round(gust_list[0]) if gust_list else '--'
        wmax  = round(max_list[0])  if max_list  else '--'

        self.sb_wind_speed.config(text=f"{wind_spd} km/h")
        self.sb_wind_gust.config( text=f"{gust} km/h" if gust != '--' else '--')
        self.sb_wind_max.config(  text=f"{wmax} km/h" if wmax != '--' else '--')

        dirs = ['N','NE','E','SE','S','SW','W','NW']
        dir_name = dirs[round(wind_deg / 45) % 8]
        self.sb_wind_dir_lbl.config(text=f"{dir_name}  {round(wind_deg)}°")
        self._draw_compass(wind_deg)

        # ── Humidity & Comfort ───────────────────────────────────
        hum       = round(cur.get('relative_humidity_2m', 0))
        dew       = cur.get('dew_point_2m')
        cloud     = cur.get('cloud_cover', 0) or 0
        temp_c    = cur.get('temperature_2m', 25)

        # Comfort index (simplified heat index approximation)
        if hum >= 40 and temp_c >= 27:
            hi = (-8.784695 + 1.61139411*temp_c + 2.338549*hum
                  - 0.14611605*temp_c*hum - 0.012308094*temp_c**2
                  - 0.016424828*hum**2 + 0.002211732*temp_c**2*hum
                  + 0.00072546*temp_c*hum**2 - 0.000003582*temp_c**2*hum**2)
        else:
            hi = temp_c
        if   hi < 27:  comfort, comfort_fg = "Comfortable",   self.GOOD
        elif hi < 32:  comfort, comfort_fg = "Warm",          self.TEXT2
        elif hi < 38:  comfort, comfort_fg = "Hot",           self.WARN
        elif hi < 45:  comfort, comfort_fg = "Very Hot",      self.DANGER
        else:          comfort, comfort_fg = "Extreme Heat",  self.DANGER

        self.sb_hum_pct.config(text=f"{hum}%")
        c = self.sb_hum_bar
        c.delete('all')
        w = c.winfo_width() or 180
        hum_color = self.GOOD if hum < 50 else (self.WARN if hum < 75 else self.DANGER)
        c.create_rectangle(0, 0, w, 5, fill=self.BORDER, outline='')
        c.create_rectangle(0, 0, int(w * hum / 100), 5, fill=hum_color, outline='')

        dew_str = f"{self._c(dew)}°" if dew is not None else '--'
        self.sb_dewpoint.config(text=dew_str)
        self.sb_cloud.config(text=f"{round(cloud)}%")
        self.sb_comfort.config(text=comfort, fg=comfort_fg)

        # ── This Week ─────────────────────────────────────────────
        for w in self.week_rows_frame.winfo_children():
            w.destroy()

        codes  = daily.get('weather_code', [])
        t_max  = daily.get('temperature_2m_max', [])
        t_min  = daily.get('temperature_2m_min', [])
        times  = daily.get('time', [])
        n7     = min(7, len(times))

        all_hi  = [float(t_max[i]) for i in range(n7) if i < len(t_max)]
        all_lo  = [float(t_min[i]) for i in range(n7) if i < len(t_min)]
        week_min = min(all_lo)  if all_lo  else 0
        week_max = max(all_hi)  if all_hi  else 40
        span     = max(week_max - week_min, 1)

        for i in range(n7):
            try:
                dt      = datetime.fromisoformat(times[i])
                day_lbl = 'Today' if i == 0 else self.DAYS_S[dt.weekday()]
            except:
                day_lbl = 'Today' if i == 0 else f"D{i+1}"

            hi_v  = float(t_max[i]) if i < len(t_max) else week_max
            lo_v  = float(t_min[i]) if i < len(t_min) else week_min
            ic, _ = self._wx(codes[i] if i < len(codes) else 0)

            row_f = tk.Frame(self.week_rows_frame, bg=self.CARD)
            row_f.pack(fill='x', pady=2)
            row_f.columnconfigure(2, weight=1)

            tk.Label(row_f, text=day_lbl, font=("Segoe UI", 8, "bold"),
                     bg=self.CARD, fg=self.ACCENT2 if i==0 else self.TEXT3,
                     width=4, anchor='w').grid(row=0, column=0, sticky='w')
            tk.Label(row_f, text=ic, font=("Segoe UI", 10),
                     bg=self.CARD).grid(row=0, column=1, padx=3)

            # Temp range bar
            bar_frame = tk.Frame(row_f, bg=self.CARD)
            bar_frame.grid(row=0, column=2, sticky='ew', padx=(2,4))
            bar_canvas = tk.Canvas(bar_frame, height=8, bg=self.CARD,
                                   highlightthickness=0)
            bar_canvas.pack(fill='x', expand=True)

            def draw_bar(cv=bar_canvas, lo=lo_v, hi=hi_v, mn=week_min, sp=span):
                W = cv.winfo_width() or 80
                cv.delete('all')
                cv.create_rectangle(0, 1, W, 7, fill=self.BORDER, outline='')
                x1 = int((lo - mn) / sp * W)
                x2 = int((hi - mn) / sp * W)
                x2 = max(x2, x1 + 4)
                cv.create_rectangle(x1, 1, x2, 7, fill=self.ACCENT, outline='')
            bar_canvas.bind('<Configure>', lambda e, fn=draw_bar: fn())
            bar_canvas.after(50, draw_bar)

            tk.Label(row_f, text=f"{self._c(lo_v)}°",
                     font=("Segoe UI", 8), bg=self.CARD, fg=self.MUTED2,
                     width=4, anchor='e').grid(row=0, column=3)
            tk.Label(row_f, text=f"{self._c(hi_v)}°",
                     font=("Segoe UI", 8, "bold"), bg=self.CARD, fg=self.WARN,
                     width=4, anchor='w').grid(row=0, column=4)

        # ── Health & Activity ────────────────────────────────────
        uv_val  = (daily.get('uv_index_max') or [0])[0] or 0
        rain0   = (daily.get('precipitation_probability_max') or [0])[0] or 0
        feels   = cur.get('apparent_temperature', temp_c)

        # UV advice
        if   uv_val < 3:  uv_adv, uv_fg = "Low — no protection needed", self.GOOD
        elif uv_val < 6:  uv_adv, uv_fg = "Moderate — wear sunscreen",  self.TEXT2
        elif uv_val < 8:  uv_adv, uv_fg = "High — SPF 30+ required",    self.WARN
        elif uv_val < 11: uv_adv, uv_fg = "Very High — limit exposure",  self.DANGER
        else:             uv_adv, uv_fg = "Extreme — stay indoors",      self.DANGER
        self.sb_uv_advice.config(text=uv_adv, fg=uv_fg)

        # Exercise
        if rain0 > 70 or hi > 38:
            ex_adv, ex_fg = "Avoid outdoor exercise", self.DANGER
        elif rain0 > 40 or hi > 33:
            ex_adv, ex_fg = "Light indoor activity",  self.WARN
        elif hi < 20:
            ex_adv, ex_fg = "Great for outdoor sport", self.GOOD
        else:
            ex_adv, ex_fg = "Good — stay hydrated",   self.GOOD
        self.sb_exercise.config(text=ex_adv, fg=ex_fg)

        # Air quality (estimated from humidity + cloud + wind)
        if wind_spd > 20 and cloud < 50:
            aq, aq_fg = "Good",        self.GOOD
        elif hum > 80 or cloud > 80:
            aq, aq_fg = "Moderate",    self.WARN
        else:
            aq, aq_fg = "Acceptable",  self.TEXT2
        self.sb_air.config(text=aq, fg=aq_fg)

        # Wind chill / heat advice
        feels_c = round(feels)
        if feels_c < 10:
            wc_txt, wc_fg = f"Cold — feels {self._c(feels)}°",   self.ACCENT2
        elif feels_c < 20:
            wc_txt, wc_fg = f"Cool — feels {self._c(feels)}°",   self.TEXT2
        elif feels_c < 32:
            wc_txt, wc_fg = f"Warm — feels {self._c(feels)}°",   self.TEXT2
        else:
            wc_txt, wc_fg = f"Hot — feels {self._c(feels)}°",    self.DANGER
        self.sb_windchill.config(text=wc_txt, fg=wc_fg)

        # Rain risk
        if   rain0 < 20:  rr_txt, rr_fg = f"Low ({rain0}%)",      self.GOOD
        elif rain0 < 50:  rr_txt, rr_fg = f"Possible ({rain0}%)", self.TEXT2
        elif rain0 < 75:  rr_txt, rr_fg = f"Likely ({rain0}%)",   self.WARN
        else:             rr_txt, rr_fg = f"Very likely ({rain0}%)", self.DANGER
        self.sb_rain_risk.config(text=rr_txt, fg=rr_fg)

