    def _draw_compass(self, deg):
        c = self.compass_cv
        c.delete('all')
        cx, cy, r = 34, 34, 30

        # Outer ring
        c.create_oval(cx-r, cy-r, cx+r, cy+r,
                      outline=self.BORDER, width=2, fill=self.BG)
        # Cardinal labels
        for label, angle in [('N',0),('E',90),('S',180),('W',270)]:
            rad = math.radians(angle - 90)
            lx  = cx + (r - 8) * math.cos(rad)
            ly  = cy + (r - 8) * math.sin(rad)
            c.create_text(lx, ly, text=label, font=("Segoe UI", 7, "bold"),
                          fill=self.MUTED2 if label != 'N' else self.ACCENT2)
        # Tick marks
        for a in range(0, 360, 45):
            rad  = math.radians(a - 90)
            x1 = cx + (r-2)  * math.cos(rad)
            y1 = cy + (r-2)  * math.sin(rad)
            x2 = cx + (r-6)  * math.cos(rad)
            y2 = cy + (r-6)  * math.sin(rad)
            c.create_line(x1, y1, x2, y2, fill=self.BORDER, width=1)
        # Arrow
        rad    = math.radians(deg - 90)
        tip_x  = cx + (r - 12) * math.cos(rad)
        tip_y  = cy + (r - 12) * math.sin(rad)
        tail_x = cx - (r - 18) * math.cos(rad)
        tail_y = cy - (r - 18) * math.sin(rad)
        c.create_line(tail_x, tail_y, tip_x, tip_y,
                      fill=self.ACCENT2, width=2, arrow='last',
                      arrowshape=(8, 10, 4))
        # Centre dot
        c.create_oval(cx-3, cy-3, cx+3, cy+3,
                      fill=self.ACCENT, outline=self.ACCENT2)

    # ══════════════════════════════════════════════════════════════
    # HELPERS
    # ══════════════════════════════════════════════════════════════
    def _wx(self, code):
        return self._WX.get(code, ('🌡️', 'Unknown'))

    def _c(self, t):
        return round((float(t) * 9/5) + 32) if self.unit == 'fahrenheit' else round(float(t))

    def _set_unit(self, u):
        self.unit = u
        self.c_btn.config(bg=self.ACCENT if u=='celsius'    else self.CARD,
                          fg='white'     if u=='celsius'    else self.MUTED)
        self.f_btn.config(bg=self.ACCENT if u=='fahrenheit' else self.CARD,
                          fg='white'     if u=='fahrenheit' else self.MUTED)
        if self.weather_data:
            self._render(self.last_city, self.last_country)

    def _clear_placeholder(self):
        if self.search_var.get() == "Search city...":
            self.search_entry.delete(0, 'end')
            self.search_entry.config(fg=self.TEXT2)

    def _restore_placeholder(self):
        if not self.search_var.get():
            self.search_entry.insert(0, "Search city...")
            self.search_entry.config(fg=self.MUTED2)

    def _save_city(self, city):
        try:
            with open('last_city.txt', 'w') as f:
                f.write(city)
        except: pass

    def _load_last_city(self):
        try:
            if os.path.exists('last_city.txt'):
                city = open('last_city.txt').read().strip()
                if city:
                    self._do_search(city)
        except: pass


