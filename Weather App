    def _do_search(self, city=None):
        if city is None:
            city = self.search_var.get().strip()
            if city == "Search city...":
                city = ""
        if not city:
            return
        self.last_city = city
        self._show('loading')
        threading.Thread(target=self._fetch, args=(city,), daemon=True).start()

    def _do_location(self):
        self._show('loading')
        threading.Thread(target=self._fetch_location, daemon=True).start()

    def _fetch(self, city):
        try:
            geo = self._get(
                f"https://nominatim.openstreetmap.org/search?format=json&q={city}&limit=1",
                headers={'User-Agent': 'MasrurWeather/2.0'}
            )
            if not geo:
                raise Exception("City not found")
            lat, lon = float(geo[0]['lat']), float(geo[0]['lon'])
            self.last_country = geo[0]['display_name'].split(',')[-1].strip()

            # ── Phase 1: show standard 16-day immediately ─────────
            std_data = self._get(self._weather_url(lat, lon))
            if not std_data:
                raise Exception("Weather data unavailable")
            self.weather_data = std_data
            self.root.after(0, lambda: self._render(city, self.last_country))
            self.root.after(0, lambda: self._save_city(city))

            # ── Phase 2: silently extend to 35 days in background ─
            threading.Thread(
                target=self._extend_forecast,
                args=(lat, lon, city, self.last_country, std_data),
                daemon=True
            ).start()

        except Exception as e:
            msg = str(e) or "City not found"
            self.root.after(0, lambda m=msg: self._show_error(m))

    def _extend_forecast(self, lat, lon, city, country, std_data):
        """Background thread: fetch GFS ensemble and update table if it arrives."""
        try:
            ens_data = self._get(self._ensemble_url(lat, lon),
                                 timeout=8, max_retries=1)
            if not ens_data:
                return
            merged = self._merge_forecasts(std_data, ens_data)
            self.weather_data = merged
            # Only refresh the table + insights, not the whole screen
            self.root.after(0, lambda d=merged.get('daily',{}):
                            self._refresh_extended(d))
        except Exception:
            pass  # Ensemble unavailable — 16-day stays, no error shown

    def _fetch_location(self):
        try:
            import json, urllib.request
            ip = json.loads(urllib.request.urlopen("http://ip-api.com/json/", timeout=8).read())
            if ip.get('status') != 'success':
                raise Exception("Location unavailable")
            lat, lon = ip['lat'], ip['lon']

            std_data = self._get(self._weather_url(lat, lon))
            if not std_data:
                raise Exception("Weather data unavailable")
            self.weather_data = std_data
            city    = ip.get('city', 'Your Location')
            country = ip.get('country', '')
            self.last_city, self.last_country = city, country
            self.root.after(0, lambda: self._render(city, country))

            threading.Thread(
                target=self._extend_forecast,
                args=(lat, lon, city, country, std_data),
                daemon=True
            ).start()
        except Exception:
            self.root.after(0, lambda: self._show_error("Could not detect location"))

    def _weather_url(self, lat, lon):
        return (
            f"https://api.open-meteo.com/v1/forecast"
            f"?latitude={lat}&longitude={lon}"
            f"&current=temperature_2m,relative_humidity_2m,apparent_temperature,"
            f"weather_code,wind_speed_10m,wind_direction_10m,surface_pressure"
            f"&hourly=temperature_2m,weather_code,precipitation_probability,"
            f"visibility,dew_point_2m,cloud_cover"
            f"&daily=weather_code,temperature_2m_max,temperature_2m_min,"
            f"precipitation_probability_max,sunrise,sunset,uv_index_max,"
            f"wind_speed_10m_max,wind_gusts_10m_max"
            f"&forecast_days=16&timezone=auto"
        )

    def _ensemble_url(self, lat, lon):
        # GFS ensemble — free, no API key, up to 35 days
        return (
            f"https://ensemble-api.open-meteo.com/v1/ensemble"
            f"?latitude={lat}&longitude={lon}"
            f"&daily=temperature_2m_max,temperature_2m_min,"
            f"precipitation_sum,weather_code,wind_speed_10m_max"
            f"&models=gfs_seamless&forecast_days=30&timezone=auto"
        )

    def _merge_forecasts(self, std, ens):
        """Merge 16-day precise forecast with GFS ensemble mean for days 17-35."""
        if not std:
            return std or {}
        if not ens:
            return std

        daily     = std.get('daily', {})
        std_times = set(daily.get('time', []))
        ens_daily = ens.get('daily', {})
        ens_times = ens_daily.get('time', [])

        # Days present in ensemble but NOT yet in standard forecast
        new_times = [t for t in ens_times if t not in std_times]
        if not new_times:
            return std

        new_indices = [i for i, t in enumerate(ens_times) if t in set(new_times)]

        def ens_mean(var):
            """Average all member columns for `var` at `new_indices`."""
            member_cols = {k: v for k, v in ens_daily.items()
                           if k.startswith(var + '_member') and isinstance(v, list)}
            if not member_cols:
                # Some builds return non-suffixed arrays (list-of-lists); handle gracefully
                raw = ens_daily.get(var)
                if isinstance(raw, list) and raw and isinstance(raw[0], list):
                    member_cols = {f'm{j}': raw[j] for j in range(len(raw))}
            result = []
            for idx in new_indices:
                vals = [col[idx] for col in member_cols.values()
                        if col and idx < len(col) and col[idx] is not None]
                result.append(round(sum(vals) / len(vals), 1) if vals else None)
            return result

        def ens_mode(var):
            """Most common weather_code across members at each new index."""
            from collections import Counter
            member_cols = {k: v for k, v in ens_daily.items()
                           if k.startswith(var + '_member') and isinstance(v, list)}
            result = []
            for idx in new_indices:
                vals = [col[idx] for col in member_cols.values()
                        if col and idx < len(col) and col[idx] is not None]
                result.append(Counter(vals).most_common(1)[0][0] if vals else 0)
            return result

        def ens_prob(var):
            """Fraction of members with precipitation_sum > 0.1 mm → percent."""
            member_cols = {k: v for k, v in ens_daily.items()
                           if k.startswith(var + '_member') and isinstance(v, list)}
            result = []
            for idx in new_indices:
                vals = [col[idx] for col in member_cols.values()
                        if col and idx < len(col) and col[idx] is not None]
                result.append(round(100 * sum(1 for v in vals if v > 0.1) / len(vals))
                              if vals else 0)
            return result

        n_new = len(new_times)

        # Extend each daily variable
        for var, fn in [('temperature_2m_max', ens_mean),
                        ('temperature_2m_min',  ens_mean),
                        ('wind_speed_10m_max',  ens_mean),
                        ('weather_code',        ens_mode)]:
            if var in daily:
                daily[var] = list(daily[var]) + fn(var)

        # Precipitation probability derived from ensemble spread
        prob_ext = ens_prob('precipitation_sum')
        if 'precipitation_probability_max' in daily:
            daily['precipitation_probability_max'] = (
                list(daily['precipitation_probability_max']) + prob_ext)

        # Extend sunrise/sunset by repeating the last known value
        for key in ('sunrise', 'sunset', 'uv_index_max',
                    'wind_gusts_10m_max'):
            if daily.get(key):
                last = daily[key][-1]
                daily[key] = list(daily[key]) + [last] * n_new

        daily['time'] = list(daily['time']) + new_times
        std['daily']  = daily
        return std

    def _get(self, url, headers=None, timeout=10, max_retries=3):
        import urllib.request, urllib.error, json, time, ssl
        hdrs = {'User-Agent': 'MasrurWeather/2.0', 'Accept': 'application/json'}
        if headers:
            hdrs.update(headers)
        # Try without SSL verification as fallback for systems with cert issues
        ctx_normal  = ssl.create_default_context()
        ctx_noverify = ssl.create_default_context()
        ctx_noverify.check_hostname = False
        ctx_noverify.verify_mode    = ssl.CERT_NONE
        last_err = None
        for attempt in range(max_retries):
            for ctx in (ctx_normal, ctx_noverify):
                try:
                    req = urllib.request.Request(url, headers=hdrs)
                    with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
                        return json.loads(resp.read().decode('utf-8'))
                except urllib.error.HTTPError as e:
                    body = ''
                    try: body = e.read().decode('utf-8', errors='ignore')[:200]
                    except Exception: pass
                    if e.code == 429:
                        time.sleep((attempt + 1) * 2)
                        last_err = f"Rate limited (429)"
                        break   # retry outer loop
                    # Expose status + reason (strip URL)
                    reason = body if body else e.reason
                    raise Exception(f"HTTP {e.code}: {reason[:100]}")
                except urllib.error.URLError as e:
                    last_err = f"URL error: {e.reason}"
                    break   # retry with next attempt
                except OSError as e:
                    last_err = str(e)
                    break
                except Exception as e:
                    last_err = str(e)
                    break
            if last_err and attempt < max_retries - 1:
                time.sleep(1)
        raise Exception(last_err or "Network request failed")

    def _refresh_extended(self, daily):
        """Called on the main thread after ensemble data arrives — update table + insights only.

        This fires several seconds AFTER the initial render, completely
        independently of it — typically while the user is already
        scrolling the page. It swaps the table from 16 to 30 rows and
        rebuilds every insight card, which changes self.center's height
        out from under an in-progress scroll. Without the same lock/sync
        treatment as _render(), this is the main reproducible trigger for
        the duplicated/overlapping sections seen mid-scroll.
        """
        self._render_lock = True
        try:
            self._render_table(daily)
            self._render_insights(daily)
        except Exception:
            pass
        finally:
            def _settle():
                self._sync_scrollregion(self._main_cv)
                self._render_lock = False
            self.root.after(100, _settle)

    def _show_error(self, msg):
        msg = str(msg)
        if 'City not found' in msg or 'city not found' in msg.lower():
            display = "City not found. Please check the spelling and try again."
        elif 'timeout' in msg.lower() or 'timed out' in msg.lower():
            display = "Connection timed out. Please check your internet and try again."
        elif 'connection' in msg.lower() or 'network' in msg.lower():
            display = "No internet connection. Please check your network settings."
        elif 'Weather data unavailable' in msg:
            display = "Weather data unavailable. Please try again."
        else:
            display = "Could not load weather data. Please try again."
        # Strip URL from technical detail but keep the error code/reason
        detail = msg
        if 'for url:' in detail:
            detail = detail.split('for url:')[0].strip()
        if len(detail) > 120:
            detail = detail[:120] + '…'
        self.error_msg.config(text=display)
        self.error_detail.config(text=detail if detail != display else '')
        self._show('error')

    # ══════════════════════════════════════════════════════════════
    # RENDER
    # ══════════════════════════════════════════════════════════════
    def _render(self, city, country):
        # Block scrolling for the duration of the rebuild — see
        # _sync_scrollregion for why scrolling mid-rebuild caused
        # sections to visually overlap/duplicate.
        self._render_lock = True
        d     = self.weather_data
        cur   = d.get('current', {})
        daily = d.get('daily',   {})

        icon, cond = self._wx(cur.get('weather_code', 0))

        # Topbar tab
        self.tab_city.config(text=city)
        self.tab_temp.config(text=f"  {self._c(cur.get('temperature_2m', 0))}°")

        # City header
        self.lbl_city.config(text=city)
        self.lbl_country.config(text=country)

        # Current
        self.lbl_ts.config(
            text=f"Current weather · {datetime.now().strftime('%I:%M %p')}")
        self.lbl_icon.config(text=icon)
        self.lbl_temp.config(text=f"{self._c(cur.get('temperature_2m', 0))}°")
        self.lbl_cond.config(text=cond)
        self.lbl_feels.config(
            text=f"Feels like {self._c(cur.get('apparent_temperature', 0))}°")

        desc_key = min(self._WX_DESC.keys(),
                       key=lambda k: abs(k - cur.get('weather_code', 0)))
        self.lbl_desc.config(text=self._WX_DESC.get(cur.get('weather_code', 0),
                             self._WX_DESC[desc_key]))

        wind = round(cur.get('wind_speed_10m', 0))
        hum  = round(cur.get('relative_humidity_2m', 0))
        # visibility comes from hourly (not in current params)
        hourly_now = self.weather_data.get('hourly', {})
        h_vis_list = hourly_now.get('visibility', [])
        vis_raw    = h_vis_list[0] if h_vis_list else 0
        vis  = (vis_raw or 0) / 1000
        pres = round(cur.get('surface_pressure', 0))

        self.meta_wind.config(text=f"💨 {wind} km/h")
        self.meta_hum.config( text=f"💧 {hum}%")
        self.meta_vis.config( text=f"👁️ {vis:.1f} km")
        self.meta_pres.config(text=f"🌡️ {pres} hPa")

        self.detail_widgets['humidity'].config(text=f"{hum}%")
        self.detail_widgets['wind'].config(    text=f"{wind} km/h")
        self.detail_widgets['pressure'].config(text=f"{pres} hPa")
        self.detail_widgets['visibility'].config(text=f"{vis:.1f} km")

        uv = (daily.get('uv_index_max') or [None])[0]
        uv_txt = f"{round(uv,1)}" if uv is not None else '--'
        self.detail_widgets['uv'].config(text=uv_txt,
            fg=self.WARN if (uv or 0) >= 6 else self.ACCENT2)

        rain0 = (daily.get('precipitation_probability_max') or [0])[0]
        self.detail_widgets['rain'].config(text=f"{rain0}%",
            fg=self.ACCENT2 if rain0 < 50 else self.WARN)

        for key, lst in (('sunrise', daily.get('sunrise',[])),
                         ('sunset',  daily.get('sunset', []))):
            val = '--'
            if lst:
                try: val = datetime.fromisoformat(lst[0].replace('Z','+00:00')).strftime('%I:%M %p')
                except: pass
            self.detail_widgets[key].config(text=val)

        # Sun/Moon sidebar
        sr_str = ss_str = '--'
        if daily.get('sunrise'):
            try: sr_str = datetime.fromisoformat(
                    daily['sunrise'][0].replace('Z','+00:00')).strftime('%I:%M %p')
            except: pass
        if daily.get('sunset'):
            try: ss_str = datetime.fromisoformat(
                    daily['sunset'][0].replace('Z','+00:00')).strftime('%I:%M %p')
            except: pass
        self.sb_sr.config(text=sr_str)
        self.sb_ss.config(text=ss_str)

        # Daylight progress bar
        try:
            sr_dt = datetime.fromisoformat(daily['sunrise'][0].replace('Z','+00:00'))
            ss_dt = datetime.fromisoformat(daily['sunset'][0].replace('Z','+00:00'))
            now_dt = datetime.now(sr_dt.tzinfo) if sr_dt.tzinfo else datetime.now()
            total = (ss_dt - sr_dt).seconds
            elapsed = max(0, (now_dt.replace(tzinfo=None) - sr_dt.replace(tzinfo=None)).seconds)
            pct = min(1.0, elapsed / total) if total else 0.5
            hrs = round(total / 3600)
            c = self.sb_bar_canvas
            c.delete('all')
            c.create_rectangle(0, 0, 100, 6, fill=self.BORDER, outline='')
            c.create_rectangle(0, 0, int(100*pct), 6, fill=self.ACCENT, outline='')
            self.sb_dur.config(text=f"{hrs}h daylight")
        except:
            pass

        # Suggestions
        for w in self.sugg_frame.winfo_children():
            w.destroy()
        suggs = [
            ('☂️', 'Umbrella',  'Bring one' if rain0 > 50 else 'No need'),
            ('👒', 'Clothing',  'Light summer' if self._c(cur.get('temperature_2m',28)) > 28 else 'Light jacket'),
            ('🌿', 'Outdoors',  'Not ideal' if rain0 > 70 else 'Take caution' if rain0 > 40 else 'Good to go'),
        ]
        for icon_s, title, sub in suggs:
            row = tk.Frame(self.sugg_frame, bg=self.CARD,
                           highlightbackground=self.BORDER, highlightthickness=1)
            row.pack(fill='x', pady=3)
            tk.Label(row, text=icon_s, font=("Segoe UI", 16),
                     bg=self.CARD, padx=10, pady=8).pack(side='left')
            txt = tk.Frame(row, bg=self.CARD)
            txt.pack(side='left')
            tk.Label(txt, text=title, font=("Segoe UI", 10, "bold"),
                     bg=self.CARD, fg=self.TEXT2).pack(anchor='w')
            tk.Label(txt, text=sub, font=("Segoe UI", 9),
                     bg=self.CARD, fg=self.MUTED).pack(anchor='w')

        # 7-day forecast
        self._render_forecast(daily)

        # Hourly chart
        self._render_hourly_chart(self.weather_data.get('hourly', {}), daily)

        # 15-day table
        self._render_table(daily)

        # Insights
        self._render_insights(daily)

        # Extra sidebar sections
        self._render_sidebar_extra(cur, daily)

        self._show('main')

        # Re-attach hover routing after dynamic widgets are created
        def _reattach():
            def _bind_enter(widget, cv):
                try:
                    widget.bind('<Enter>',
                        lambda e, c=cv: setattr(self, '_scroll_target', c), add='+')
                    for child in widget.winfo_children():
                        _bind_enter(child, cv)
                except Exception:
                    pass
            _bind_enter(self.center,  self._main_cv)
            _bind_enter(self.sidebar, self._sb_cv)

            # Recompute scrollregion only after Tk has fully settled the
            # batch of widget destroy/recreate calls above, then snap the
            # view back to the top of the freshly-rendered city so the
            # user never lands on an offset computed from the *previous*
            # city's (different-height) layout.
            self._sync_scrollregion(self._main_cv)
            self._sync_scrollregion(self._sb_cv)
            self._main_cv.yview_moveto(0)
            self._sb_cv.yview_moveto(0)
            self._render_lock = False
        self.root.after(100, _reattach)

    def _animate_label_color(self, widget, _from, to_col, *_):
        """Instant label color — no stacking after() chains."""
        try:
            widget.config(fg=to_col)
        except tk.TclError:
            pass

    def _smooth_hover(self, widget, _from, to_col, *_):
        """Instant background color for widget + direct children."""
        try:
            widget.config(bg=to_col,
                          highlightbackground=to_col if to_col != self.CARD else self.BORDER)
        except tk.TclError:
            return
        for child in widget.winfo_children():
            try:
                child.config(bg=to_col)
            except tk.TclError:
                pass

    # ─────────────────────────────────────────────────────────────
    def _render_forecast(self, daily):
        for w in self.fc_frame.winfo_children():
            w.destroy()
        self._fc_cards.clear()
        self._close_day_detail()   # reset panel on new data

        codes  = daily.get('weather_code', [])
        t_max  = daily.get('temperature_2m_max', [])
        t_min  = daily.get('temperature_2m_min', [])
        precip = daily.get('precipitation_probability_max', [])
        times  = daily.get('time', [])
        n = min(7, len(codes))

        for i in range(n):
            ic, cn = self._wx(codes[i] if i < len(codes) else 0)
            try:
                dt = datetime.fromisoformat(times[i])
                day_lbl = 'Today' if i == 0 else self.DAYS_S[dt.weekday()]
            except:
                day_lbl = 'Today' if i == 0 else f"Day {i+1}"

            is_today = (i == 0)
            bg  = "#162d50" if is_today else self.CARD
            bdr = self.ACCENT if is_today else self.BORDER

            card = tk.Frame(self.fc_frame, bg=bg,
                            highlightbackground=bdr, highlightthickness=1,
                            cursor='hand2')
            card.pack(side='left', padx=4, fill='both', expand=True)
            self._fc_cards.append((card, is_today))

            # Click → show/toggle day detail
            for w in (card,):
                w.bind('<Button-1>', lambda e, idx=i: self._show_day_detail(idx))

            hover_bg = "#1e3a60" if is_today else "#1a2e4a"
            card.bind('<Enter>', lambda e, w=card, nb=hover_bg, ob=bg:
                      self._smooth_hover(w, ob, nb))
            card.bind('<Leave>', lambda e, w=card, ob=bg, nb=hover_bg:
                      self._smooth_hover(w, nb, ob))

            day_fg = self.ACCENT2 if is_today else self.MUTED
            for widget_data in [
                ('label', day_lbl, ("Segoe UI", 9, "bold"),  day_fg,    (10, 2)),
                ('label', ic,       ("Segoe UI", 26),          self.TEXT, (2,  2)),
            ]:
                lbl = tk.Label(card, text=widget_data[1], font=widget_data[2],
                               bg=bg, fg=widget_data[3])
                lbl.pack(pady=widget_data[4])
                lbl.bind('<Button-1>', lambda e, idx=i: self._show_day_detail(idx))

            hi_lbl = tk.Label(card, text=f"{self._c(t_max[i]) if i<len(t_max) else '--'}°",
                              font=("Segoe UI", 13, "bold"), bg=bg, fg=self.TEXT)
            hi_lbl.pack()
            hi_lbl.bind('<Button-1>', lambda e, idx=i: self._show_day_detail(idx))

            lo_lbl = tk.Label(card, text=f"{self._c(t_min[i]) if i<len(t_min) else '--'}°",
                              font=("Segoe UI", 10), bg=bg, fg=self.MUTED2)
            lo_lbl.pack()
            lo_lbl.bind('<Button-1>', lambda e, idx=i: self._show_day_detail(idx))

            rn_lbl = tk.Label(card, text=f"💧 {precip[i] if i<len(precip) else 0}%",
                              font=("Segoe UI", 9), bg=bg, fg=self.ACCENT2)
            rn_lbl.pack(pady=(2, 4))
            rn_lbl.bind('<Button-1>', lambda e, idx=i: self._show_day_detail(idx))

            cn_lbl = tk.Label(card, text=cn, font=("Segoe UI", 8), bg=bg, fg=self.MUTED2)
            cn_lbl.pack(pady=(0, 8))
            cn_lbl.bind('<Button-1>', lambda e, idx=i: self._show_day_detail(idx))

    # ─────────────────────────────────────────────────────────────
    def _render_table(self, daily):
        for row in self.tree.get_children():
            self.tree.delete(row)

        codes  = daily.get('weather_code', [])
        t_max  = daily.get('temperature_2m_max', [])
        t_min  = daily.get('temperature_2m_min', [])
        precip = daily.get('precipitation_probability_max', [])
        times  = daily.get('time', [])

        for i in range(min(30, len(times))):
            try:
                dt   = datetime.fromisoformat(times[i].replace('Z','+00:00'))
                ic, cn = self._wx(codes[i] if i < len(codes) else 0)
                hi   = self._c(t_max[i])  if i < len(t_max)  else '--'
                lo   = self._c(t_min[i])  if i < len(t_min)  else '--'
                rain = precip[i]           if i < len(precip) else 0
                date_str = f"{self.MONTHS[dt.month-1]} {dt.day}, {dt.year}"
                tag = ('today' if i == 0 else ('odd' if i % 2 else ''))
                self.tree.insert('', 'end', values=(
                    date_str,
                    self.DAYS_F[dt.weekday()],
                    f"{ic} {cn[:14]}",
                    f"H: {hi}°",
                    f"L: {lo}°",
                    f"{rain}%",
                ), tags=(tag,))
            except:
                continue

