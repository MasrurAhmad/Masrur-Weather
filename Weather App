    # ─────────────────────────────────────────────────────────────
    def _render_hourly_chart(self, hourly, daily):
        c = self.hourly_cv
        c.delete('all')

        # Layout constants
        COL_W    = 68
        PAD_L    = 20
        PAD_T    = 30     # space above curve for temp labels
        CHART_H  = 95     # height of the curve area
        CHART_T  = PAD_T
        CHART_B  = CHART_T + CHART_H
        ICON_T   = CHART_B + 14
        TIME_T   = ICON_T  + 34
        RAIN_T   = TIME_T  + 22
        TOTAL_H  = RAIN_T  + 24

        all_times = hourly.get('time',   [])
        all_temps = hourly.get('temperature_2m', [])
        all_codes = hourly.get('weather_code', [])
        all_rain  = hourly.get('precipitation_probability', [])

        # Find starting index (first hour >= now)
        now = datetime.now()
        start = 0
        for i, t_str in enumerate(all_times):
            try:
                dt = datetime.fromisoformat(t_str.replace('Z',''))
                if dt >= now.replace(minute=0, second=0, microsecond=0):
                    start = i; break
            except Exception:
                pass

        # Pick every 2 hours for 30 hours = 15 visible slots + 1 extra for curve tail
        N_SLOTS = 16
        STEP    = 2
        indices = [start + j*STEP for j in range(N_SLOTS)
                   if start + j*STEP < len(all_times)]
        n = len(indices)
        if n < 3:
            return

        TOTAL_W = PAD_L + n * COL_W + PAD_L
        c.configure(scrollregion=(0, 0, TOTAL_W, TOTAL_H), height=TOTAL_H)

        # Temperature values
        temps = []
        for idx in indices:
            try:    temps.append(float(all_temps[idx]))
            except: temps.append(0.0)
        mn   = min(temps) - 2.5
        mx   = max(temps) + 3.5
        span = max(mx - mn, 1)

        def xof(i): return PAD_L + COL_W//2 + i * COL_W
        def yof(t): return CHART_T + int((1 - (t - mn) / span) * CHART_H)

        raw_pts = [(xof(i), yof(temps[i])) for i in range(n)]

        # Catmull-Rom smooth curve points
        def cr(pts):
            out = []
            m = len(pts)
            for i in range(m - 1):
                p0 = pts[max(i-1, 0)]
                p1 = pts[i]
                p2 = pts[i+1]
                p3 = pts[min(i+2, m-1)]
                for k in range(18):
                    t  = k / 18
                    t2, t3 = t*t, t*t*t
                    x = .5*(2*p1[0]+(-p0[0]+p2[0])*t+(2*p0[0]-5*p1[0]+4*p2[0]-p3[0])*t2+(-p0[0]+3*p1[0]-3*p2[0]+p3[0])*t3)
                    y = .5*(2*p1[1]+(-p0[1]+p2[1])*t+(2*p0[1]-5*p1[1]+4*p2[1]-p3[1])*t2+(-p0[1]+3*p1[1]-3*p2[1]+p3[1])*t3)
                    out.append((x, y))
            out.append(pts[-1])
            return out

        smooth = cr(raw_pts)

        # ── Gradient fill (3 layers from bottom) ─────────────────
        for fill_col, y_extra in [('#0c1f38',14),('#102540',8),('#142d4c',2)]:
            poly = ([(smooth[0][0], CHART_B + y_extra)] +
                    smooth +
                    [(smooth[-1][0], CHART_B + y_extra)])
            c.create_polygon(poly, fill=fill_col, outline='')

        # ── Sunrise / Sunset dashed markers ──────────────────────
        def draw_time_marker(iso_str, label, color):
            try:
                dt_m = datetime.fromisoformat(iso_str.replace('Z',''))
                # Find fractional position on x-axis
                # Map between indices[0] and indices[-1] time
                t0 = datetime.fromisoformat(all_times[indices[0]].replace('Z',''))
                t1 = datetime.fromisoformat(all_times[indices[-1]].replace('Z',''))
                span_s = (t1 - t0).total_seconds()
                if span_s <= 0: return
                pos = (dt_m - t0).total_seconds() / span_s
                if not (0 <= pos <= 1): return
                x_m = PAD_L + COL_W//2 + pos * (n - 1) * COL_W
                # Dashed line
                y = CHART_T - 10
                for seg in range(0, CHART_H + 10, 8):
                    c.create_line(x_m, y+seg, x_m, min(y+seg+4, CHART_B),
                                  fill=color, width=1)
                # Label
                time_str = dt_m.strftime('%I:%M').lstrip('0')
                c.create_text(x_m, CHART_T - 16, text=label + ' ' + time_str,
                              font=("Segoe UI", 8, "bold"), fill=color)
            except Exception:
                pass

        if daily.get('sunrise') and daily['sunrise'][0]:
            draw_time_marker(daily['sunrise'][0], '🌅', '#f5c842')
        if daily.get('sunset') and daily['sunset'][0]:
            draw_time_marker(daily['sunset'][0], '🌇', '#f5a030')

        # ── Curve line ────────────────────────────────────────────
        flat = [v for pt in smooth for v in pt]
        if len(flat) >= 4:
            c.create_line(flat, fill='#4a9be0', width=2, smooth=False)

        # ── Per-slot: dot, temp, icon, time, rain ─────────────────
        for i, idx in enumerate(indices[:-1]):   # skip last tail point
            x = xof(i)

            # Dot
            y = raw_pts[i][1]
            c.create_oval(x-4, y-4, x+4, y+4,
