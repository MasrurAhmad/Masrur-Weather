            wrapper, bg=self.CARD,
            highlightbackground=self.ACCENT, highlightthickness=1)
        # NOT packed yet — shown on demand

        # ── Header ────────────────────────────────────────────────
        hdr = tk.Frame(outer, bg=self.CARD)
        hdr.pack(fill='x', padx=14, pady=(10,6))
