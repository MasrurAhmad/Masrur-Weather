                                     bg=self.CARD, fg=self.TEXT3)
        self._dd_cond_lbl.pack(anchor='w')

        # ── Stat tiles (8) ────────────────────────────────────────
        stats_row = tk.Frame(outer, bg=self.CARD)
        stats_row.pack(fill='x', padx=14, pady=(0,10))
        self._dd_stats = {}
        for key, icon, label in [
            ('high',    '🌡️', 'High'),
            ('low',     '❄️',  'Low'),
            ('feels',   '🤔', 'Feels Like'),
            ('rain',    '💧', 'Rain'),
            ('wind',    '💨', 'Wind'),
            ('uv',      '🔆', 'UV Index'),
            ('sunrise', '🌅', 'Sunrise'),
            ('sunset',  '🌇', 'Sunset'),
