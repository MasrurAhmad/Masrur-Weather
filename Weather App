        self.container.grid(row=1, column=0, sticky='nsew')
        self.container.rowconfigure(0, weight=1)
        self.container.columnconfigure(0, weight=1)

        self._build_welcome()
        self._build_loading()
        self._build_error()
        self._build_main()

    def _show(self, name):
        mapping = {
            'welcome': self.welcome_frame,
            'loading': self.loading_frame,
            'error':   self.error_frame,
            'main':    self.main_frame,
        }
        for w in mapping.values():
            w.grid_remove()
        mapping[name].grid(row=0, column=0, sticky='nsew')
        if name == 'loading':
            self.root.after(1, self._start_spinner)
        else:
            self._stop_spinner()

