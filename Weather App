    # ══════════════════════════════════════════════════════════════
    # LOADING SCREEN  (animated spinner)
    # ══════════════════════════════════════════════════════════════
    def _build_loading(self):
        f = self.loading_frame = tk.Frame(self.container, bg=self.CARD2)
        inner = tk.Frame(f, bg=self.CARD2)
        inner.place(relx=0.5, rely=0.45, anchor='center')
        self._spinner_cv = tk.Canvas(inner, width=72, height=72,
                                     bg=self.CARD2, highlightthickness=0)
        self._spinner_cv.pack(pady=(0,18))
        tk.Label(inner, text="Loading weather data…",
                 font=("Segoe UI", 14), bg=self.CARD2, fg=self.ACCENT2).pack()

    def _start_spinner(self):
        self._spinner_running = True
        self._tick_spinner()

    def _stop_spinner(self):
        self._spinner_running = False

    def _tick_spinner(self):
        if not self._spinner_running:
            return
        c = self._spinner_cv
        c.delete('all')
        # Outer faint ring
        c.create_oval(6, 6, 66, 66, outline=self.BORDER, width=4)
        # Spinning arc (270° sweep, head slightly brighter)
        c.create_arc(6, 6, 66, 66,
                     start=self._spinner_angle, extent=270,
                     outline=self.ACCENT, width=4, style='arc')
        # Bright leading dot
        import math
        rad = math.radians(self._spinner_angle + 270 - 90)
        cx = cy = 36
        r  = 30
        dx = cx + r * math.cos(rad)
        dy = cy + r * math.sin(rad)
        c.create_oval(dx-4, dy-4, dx+4, dy+4,
                      fill=self.ACCENT2, outline='')
        self._spinner_angle = (self._spinner_angle + 8) % 360
        c.after(12, self._tick_spinner)

