    # ══════════════════════════════════════════════════════════════
    # MAIN WEATHER SCREEN
    # ══════════════════════════════════════════════════════════════
    def _build_main(self):
        f = self.main_frame = tk.Frame(self.container, bg=self.BG)
        f.rowconfigure(0, weight=1)
        f.columnconfigure(0, weight=1)
        f.columnconfigure(1, weight=0)

        self._style_scrollbars()

        # ── Centre column: canvas + a REAL, visible vertical scrollbar ──
        # Scrolling is now entirely delegated to Tk's own scrollbar/canvas
        # protocol (Scrollbar.command -> canvas.yview, canvas.yscrollcommand
        # -> Scrollbar.set). That's the same plumbing every Tk app has used
        # for 25+ years; it's what actually repaints correctly, unlike the
        # hand-rolled fractional yview_moveto() jumps used previously.
        main_col = tk.Frame(f, bg=self.BG)
        main_col.grid(row=0, column=0, sticky='nsew')
        main_col.rowconfigure(0, weight=1)
        main_col.columnconfigure(0, weight=1)
        main_col.columnconfigure(1, weight=0)

        main_cv = tk.Canvas(main_col, bg=self.BG, highlightthickness=0,
                            yscrollincrement=1)
        main_cv.grid(row=0, column=0, sticky='nsew')
        self._main_cv = main_cv

        main_vbar = ttk.Scrollbar(main_col, orient='vertical',
                                  style='Weather.Vertical.TScrollbar',
                                  command=main_cv.yview)
        main_vbar.grid(row=0, column=1, sticky='ns')
        main_cv.configure(yscrollcommand=main_vbar.set)
        self._main_vbar = main_vbar

        self.center = tk.Frame(main_cv, bg=self.BG)
        self._canvas_win = main_cv.create_window((0, 0), window=self.center, anchor='nw')
        main_cv.bind('<Configure>',
            lambda e: main_cv.itemconfig(self._canvas_win, width=e.width))
        self.center.bind('<Configure>', lambda e: self._sync_scrollregion(main_cv))

        # ── Sidebar column: canvas + its own real vertical scrollbar ────
        sb_outer = tk.Frame(f, bg=self.BG, width=246)
        sb_outer.grid(row=0, column=1, sticky='nsew')
        sb_outer.grid_propagate(False)
        sb_outer.rowconfigure(0, weight=1)
        sb_outer.columnconfigure(0, weight=1)
        sb_outer.columnconfigure(1, weight=0)

        sb_cv = tk.Canvas(sb_outer, bg=self.BG, highlightthickness=0,
                          yscrollincrement=1)
        sb_cv.grid(row=0, column=0, sticky='nsew')
        self._sb_cv = sb_cv

        sb_vbar = ttk.Scrollbar(sb_outer, orient='vertical',
                                style='Weather.Vertical.TScrollbar',
                                command=sb_cv.yview)
        sb_vbar.grid(row=0, column=1, sticky='ns')
        sb_cv.configure(yscrollcommand=sb_vbar.set)
        self._sb_vbar = sb_vbar

        self.sidebar = tk.Frame(sb_cv, bg=self.BG)
        self._sb_win = sb_cv.create_window((0, 0), window=self.sidebar, anchor='nw')
        self.sidebar.bind('<Configure>', lambda e: self._sync_scrollregion(sb_cv))
        sb_cv.bind('<Configure>',
            lambda e: sb_cv.itemconfig(self._sb_win, width=e.width))

        # ── Mouse wheel: a thin convenience on top of the scrollbar ─────
        # Each notch just asks Tk to move by a few of its own native
        # "units" (1 unit == 1px, since yscrollincrement=1 above) — the
        # same call a click on the scrollbar's trough would make. No
        # fraction math, no manual repaint forcing: this is Tk's own
        # scroll path, the same one the visible scrollbar thumb uses.
        self._scroll_target = main_cv

        def _on_wheel(event):
            if self._render_lock:
                return
            self._scroll_target.yview_scroll(int(-event.delta / 2), 'units')

        # Route wheel to the canvas the mouse is currently hovering over
        for widget in (main_cv, self.center):
            widget.bind('<Enter>', lambda e, c=main_cv:
                        setattr(self, '_scroll_target', c), add='+')
        for widget in (sb_cv, self.sidebar):
            widget.bind('<Enter>', lambda e, c=sb_cv:
                        setattr(self, '_scroll_target', c), add='+')

        self.root.bind_all('<MouseWheel>', _on_wheel)

        self._build_center_widgets()
        self._build_sidebar_widgets()

    # ── Dark-themed scrollbar matching the rest of the UI ───────────
    def _style_scrollbars(self):
        style = ttk.Style()
        style.theme_use('clam')
        style.configure('Weather.Vertical.TScrollbar',
                        background=self.BORDER, troughcolor=self.BG,
                        bordercolor=self.BG, arrowcolor=self.TEXT3,
                        relief='flat', width=12)
        style.map('Weather.Vertical.TScrollbar',
                  background=[('active', self.ACCENT), ('pressed', self.ACCENT)])
        style.configure('Weather.Horizontal.TScrollbar',
                        background=self.BORDER, troughcolor=self.CARD,
                        bordercolor=self.CARD, arrowcolor=self.TEXT3,
                        relief='flat', width=10)
        style.map('Weather.Horizontal.TScrollbar',
                  background=[('active', self.ACCENT), ('pressed', self.ACCENT)])

    # ── Force a canvas's scrollregion to match its CURRENT content ──
    def _sync_scrollregion(self, cv):
        """Flush pending geometry work, then recompute scrollregion.

        A single render pass can destroy/recreate a dozen child widgets
        in a row (forecast cards, table rows, insight cards), each
        potentially queuing its own resize before Tk has settled the
        previous one. Forcing idle tasks to run before reading bbox('all')
        avoids capturing a transitional (too-small) bounding box, which
        is what the real scrollbar's thumb size/position is computed from.
        """
        try:
            cv.update_idletasks()
            bbox = cv.bbox('all')
            if bbox:
                cv.configure(scrollregion=bbox)
        except tk.TclError:
            pass

