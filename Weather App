    def _show_day_detail(self, day_idx):
        """Toggle or switch day detail panel."""
        if self._selected_day_idx == day_idx:
            self._close_day_detail(); return

        self._selected_day_idx = day_idx
        self._update_card_highlights()

        d = self.weather_data.get('daily',  {})
        h = self.weather_data.get('hourly', {})

        codes  = d.get('weather_code', [])
        t_max  = d.get('temperature_2m_max', [])
        t_min  = d.get('temperature_2m_min', [])
        t_app  = d.get('apparent_temperature_max', [])
        precip = d.get('precipitation_probability_max', [])
        wind   = d.get('wind_speed_10m_max', [])
        uv     = d.get('uv_index_max', [])
        times  = d.get('time', [])
        sunrises = d.get('sunrise', [])
        sunsets  = d.get('sunset',  [])

        i = day_idx
        ic, cn = self._wx(codes[i] if i < len(codes) else 0)
        try:
            dt      = datetime.fromisoformat(times[i])
            day_str = 'Today' if i == 0 else self.DAYS_F[dt.weekday()]
            date_str= f"{self.MONTHS[dt.month-1]} {dt.day}, {dt.year}"
        except Exception:
            day_str = f"Day {i+1}"; date_str = ''

        hi   = self._c(t_max[i])  if i < len(t_max)  else '--'
        lo   = self._c(t_min[i])  if i < len(t_min)  else '--'
        rain = precip[i]          if i < len(precip) else 0
        wnd  = round(wind[i])     if i < len(wind)   else '--'
        uvi  = round(uv[i], 1)   if i < len(uv)     else '--'

        sr_str = ss_str = '--'
        if i < len(sunrises) and sunrises[i]:
            try: sr_str = datetime.fromisoformat(sunrises[i].replace('Z','')).strftime('%I:%M %p')
            except: pass
        if i < len(sunsets) and sunsets[i]:
            try: ss_str = datetime.fromisoformat(sunsets[i].replace('Z','')).strftime('%I:%M %p')
            except: pass

        # Feels-like: use current if today, else estimate from t_max
        feels = '--'
        if i == 0:
            feels = f"{self._c(self.weather_data.get('current',{}).get('apparent_temperature', t_max[i] if i<len(t_max) else 0))}°"
        elif i < len(t_max):
            feels = f"{self._c(t_max[i] - 1)}°"   # rough estimate

        self._dd_icon.config(text=ic)
        self._dd_day_lbl.config(text=day_str)
        self._dd_date_lbl.config(text=date_str)
        self._dd_cond_lbl.config(text=cn)
        self._dd_stats['high'].config(text=f"{hi}°",    fg=self.WARN)
        self._dd_stats['low'].config( text=f"{lo}°",    fg=self.ACCENT2)
        self._dd_stats['feels'].config(text=feels,      fg=self.TEXT2)
        self._dd_stats['rain'].config( text=f"{rain}%", fg=self.ACCENT2 if rain<50 else self.WARN)
        self._dd_stats['wind'].config( text=f"{wnd} km/h", fg=self.TEXT2)
        self._dd_stats['uv'].config(   text=str(uvi),   fg=self.WARN if float(uvi or 0)>=6 else self.TEXT2)
        self._dd_stats['sunrise'].config(text=sr_str,   fg=self.TEXT2)
        self._dd_stats['sunset'].config( text=ss_str,   fg=self.TEXT2)

        self._draw_day_detail_chart(i, h)
        self._draw_day_hourly_rows(i, h)

        # Show panel
        self._dd_outer.pack(fill='x', padx=14, pady=(0,8))
        # The panel adds a tall block into self.center; resync immediately
        # so a scroll right after clicking a day card doesn't use the
        # pre-expansion bounds.
        self._sync_scrollregion(self._main_cv)

    def _close_day_detail(self):
        self._selected_day_idx = None
        self._dd_outer.pack_forget()
        self._update_card_highlights()
        self._sync_scrollregion(self._main_cv)

    def _update_card_highlights(self):
        """Refresh card border/bg to reflect which day is selected."""
        for idx, (card, is_today) in enumerate(self._fc_cards):
            selected = (idx == self._selected_day_idx)
            if selected:
                bg = "#1a3568"; bdr = self.ACCENT2
            elif is_today:
                bg = "#162d50"; bdr = self.ACCENT
            else:
                bg = self.CARD;  bdr = self.BORDER
            try:
                card.config(bg=bg, highlightbackground=bdr)
                for child in card.winfo_children():
                    try: child.config(bg=bg)
                    except tk.TclError: pass
            except tk.TclError:
                pass

    def _draw_day_detail_chart(self, day_idx, hourly):
        """Draw a 24-hour temperature curve for the selected day."""
        c = self._dd_cv
        c.delete('all')
        c.update_idletasks()
        W = max(c.winfo_width(), 600)

        h_temps = hourly.get('temperature_2m', [])
        h_codes = hourly.get('weather_code', [])
        h_rain  = hourly.get('precipitation_probability', [])

        base = day_idx * 24
        temps, codes_h, rains = [], [], []
        for j in range(24):
            idx = base + j
            temps.append(float(h_temps[idx]) if idx < len(h_temps) else 0)
            codes_h.append(h_codes[idx] if idx < len(h_codes) else 0)
            rains.append(h_rain[idx]    if idx < len(h_rain)  else 0)

        if not temps: return

        PAD_L=30; PAD_R=20; PAD_T=28; PAD_B=16
        CHART_H = 170 - PAD_T - PAD_B
        mn = min(temps) - 1.5
        mx = max(temps) + 2.5
        span = max(mx - mn, 1)
        col_w = (W - PAD_L - PAD_R) / 23

        def xof(j): return PAD_L + j * col_w
        def yof(t): return PAD_T + (1 - (t - mn) / span) * CHART_H

        raw = [(xof(j), yof(temps[j])) for j in range(24)]

        def cr(pts):
            out = []
            n = len(pts)
            for i in range(n - 1):
                p0,p1,p2,p3 = pts[max(i-1,0)],pts[i],pts[i+1],pts[min(i+2,n-1)]
                for k in range(14):
                    t = k/14; t2,t3 = t*t,t*t*t
                    x = .5*(2*p1[0]+(-p0[0]+p2[0])*t+(2*p0[0]-5*p1[0]+4*p2[0]-p3[0])*t2+(-p0[0]+3*p1[0]-3*p2[0]+p3[0])*t3)
                    y = .5*(2*p1[1]+(-p0[1]+p2[1])*t+(2*p0[1]-5*p1[1]+4*p2[1]-p3[1])*t2+(-p0[1]+3*p1[1]-3*p2[1]+p3[1])*t3)
                    out.append((x, y))
            out.append(pts[-1]); return out

        smooth = cr(raw)
        fill_pts = [(smooth[0][0], PAD_T + CHART_H + 5)] + smooth + [(smooth[-1][0], PAD_T + CHART_H + 5)]
        c.create_polygon(fill_pts, fill='#0e2344', outline='')
        flat = [v for pt in smooth for v in pt]
        if len(flat) >= 4:
            c.create_line(flat, fill='#4a9be0', width=2, smooth=False)

        # Dots + temp label every 3h. The icon/time/rain captions that used
        # to sit under the curve here were an exact duplicate of the tile
        # row _draw_day_hourly_rows draws right below this chart, so the
        # same 8 data points were shown twice in a row — removed.
        for j in range(24):
            x, y = raw[j]
            c.create_oval(x-3, y-3, x+3, y+3, fill='#5bc5e8', outline='#0a1628', width=1)
            if j % 3 == 0:
                c.create_text(x, y - 13, text=f"{self._c(temps[j])}°",
                              font=('Segoe UI', 8, 'bold'), fill='#c8daf5')

    def _draw_day_hourly_rows(self, day_idx, hourly):
        """Draw 8 three-hourly summary tiles below the chart."""
        for w in self._dd_hourly_frame.winfo_children():
            w.destroy()

        h_temps = hourly.get('temperature_2m', [])
        h_codes = hourly.get('weather_code', [])
        h_rain  = hourly.get('precipitation_probability', [])
        h_wind  = hourly.get('wind_speed_10m', []) if 'wind_speed_10m' in hourly else []
        base    = day_idx * 24

        for j in range(0, 24, 3):
            idx = base + j
            temp = float(h_temps[idx]) if idx < len(h_temps) else 0
            code = h_codes[idx]        if idx < len(h_codes) else 0
            rain = h_rain[idx]         if idx < len(h_rain)  else 0
            ic, cn = self._wx(code)
            h_label = f"{'12' if j%12==0 else j%12}:00 {'AM' if j<12 else 'PM'}"
            if j == 0: h_label = '12:00 AM'

            tile = tk.Frame(self._dd_hourly_frame, bg=self.BG,
                            highlightbackground=self.BORDER, highlightthickness=1)
            tile.pack(side='left', padx=3, fill='both', expand=True)
            tk.Label(tile, text=h_label, font=("Segoe UI", 8),
                     bg=self.BG, fg=self.MUTED2).pack(pady=(6,1))
            tk.Label(tile, text=ic, font=("Segoe UI", 18), bg=self.BG).pack()
            tk.Label(tile, text=f"{self._c(temp)}°",
                     font=("Segoe UI", 10, "bold"), bg=self.BG, fg=self.TEXT2).pack()
            tk.Label(tile, text=f"💧{rain}%" if rain else "—",
                     font=("Segoe UI", 8), bg=self.BG,
                     fg=self.ACCENT2 if rain else self.MUTED2).pack(pady=(1,6))

